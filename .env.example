# Supabase (required for raffles, members, auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Wix (existing – being migrated away)
NEXT_PUBLIC_WIX_CLIENT_ID=
NEXT_PUBLIC_WIX_SITE_ID=
# ... other Wix vars

# Media migration: if Wix returns 403, set this to your Wix site URL (e.g. https://yoursite.wixsite.com/yoursite)
# WIX_REFERER_URL=https://www.wix.com/

# Admin onboarding – 6-digit code to add admin via /admin-onboarding (secret URL)
ADMIN_ONBOARDING_CODE=123456

# Resend – welcome, order confirmations & admin notifications
# Get API key: https://resend.com/api-keys
# Use onboarding@resend.dev for testing; use your verified domain for production
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=COCO HAWAII <onboarding@resend.dev>

# Admin – receives order notifications (premade & custom hat orders)
ADMIN_EMAIL=cocohawaii.world@gmail.com
